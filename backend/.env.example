# Server Configuration
PORT=5001
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Connection URI)
MONGODB_URI=mongodb://localhost:27017/crackd

# Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# AI Integration Keys (Optional - Local AI Fallback active if omitted)
GEMINI_API_KEY=
GROQ_API_KEY=

# Cloudinary (Optional - For profile image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (Optional - For Google Login)
GOOGLE_CLIENT_ID=

# Email / SMTP (Optional - For Password Reset Emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
